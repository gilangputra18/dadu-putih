{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/login",
      "destination": "https://accounts.google.com/ServiceLogin?hl=id&passive=true&continue=https://www.google.com/",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
